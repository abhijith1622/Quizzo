
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB Atlas or local MongoDB connection URI.
# If provided, Quizzo persists all users, quizzes, sessions, and scorecards to MongoDB.
# If omitted or empty, Quizzo gracefully uses its built-in in-memory document store.
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quizzo?retryWrites=true&w=majority
MONGODB_URI=""

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth 2.0 Web Client ID for Google One Tap & Sign In.
# Created in Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Example: "1234567890-abcdefgh.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="364422628626-mbvrd1km2eo2jjj8l9tc5uijbmut6913.apps.googleusercontent.com"

# JWT_ACCESS_SECRET: Secret key for signing user authentication tokens.
JWT_ACCESS_SECRET="quizzo-jwt-production-secret-key-2025"
